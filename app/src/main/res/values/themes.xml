<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AbsenMarsa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Tema saat aplikasi baru dibuka (splash), lalu berganti ke Theme.AbsenMarsa -->
    <style name="Theme.AbsenMarsa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AbsenMarsa</item>
    </style>
</resources>
